    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeUsageWidget</AssemblyName>
    <ApplicationIcon>Assets\claude-code-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\claude-code-icon.png" />
    <Resource Include="Assets\claude-code-icon.ico" />
  </ItemGroup>

</Project>
