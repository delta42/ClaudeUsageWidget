<Window x:Class="ClaudeUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage"
        Icon="Assets/claude-code-icon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="150"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Log in / show browser" Click="LogIn_Click"/>
            <MenuItem Header="Refresh now" Click="RefreshNow_Click"/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- The outer border is the accent stripe: it paints the profile's colour and
         the inner border covers all but a few pixels of its left edge. Sizing the
         stripe with the outer Padding avoids having to clip a child to the
         rounded corners. -->
    <Border x:Name="AccentBorder" CornerRadius="8" Background="Transparent" Padding="0"
            ToolTip="Claude session usage — right-click for options">
        <Border x:Name="BodyBorder" CornerRadius="8" Background="#CC1E1E1E" Padding="10,7">
            <Grid x:Name="ContentGrid">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="IconImage" Source="Assets/claude-code-icon.png" Width="37" Height="37" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="ValueText"
                               Text="--%"
                               Foreground="White"
                               FontSize="28"
                               FontFamily="Segoe UI Semibold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ResetText"
                           Text=""
                           Foreground="#BBBBBB"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="WeeklyText"
                           Text=""
                           Visibility="Collapsed"
                           Foreground="#BBBBBB"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- "You can't use this account right now" marker. It lives in a Canvas so
                 it contributes no desired size of its own: the slash is measured from
                 the grid it is drawn over, which would otherwise be circular. -->
            <Canvas IsHitTestVisible="False">
                <Line x:Name="BlockedSlash"
                      Visibility="Collapsed"
                      X1="0" Y1="0"
                      X2="{Binding ActualWidth, ElementName=ContentGrid}"
                      Y2="{Binding ActualHeight, ElementName=ContentGrid}"
                      Stroke="#E8655F"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.9"/>
            </Canvas>
            </Grid>
        </Border>
    </Border>
</Window>
