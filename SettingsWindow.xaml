<Window x:Class="ClaudeUsageWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Settings"
        Icon="Assets/claude-code-icon.ico"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="ProfileLabel" Margin="0,0,0,12" Foreground="#666666"/>

        <TextBlock Text="Page URL" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Margin="0,0,0,12"/>

        <TextBlock Text="Refresh rate (seconds)" Margin="0,0,0,4"/>
        <TextBox x:Name="RefreshBox" Margin="0,0,0,16"/>

        <TextBlock Text="Accent colour" Margin="0,0,0,4"/>
        <ComboBox x:Name="AccentBox" Margin="0,0,0,16" MaxDropDownHeight="260"/>

        <CheckBox x:Name="LaunchAtStartupBox" Content="Launch at Windows startup" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
